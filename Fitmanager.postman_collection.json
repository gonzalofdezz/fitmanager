{
  "info": {
    "_postman_id": "fitmanager-collection",
    "name": "Fitmanager API",
    "description": "Colección de endpoints de la API Fitmanager - Spring Boot Hexagonal Architecture",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Clases",
      "item": [
        {
          "name": "Obtener todas las clases",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/clases",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clases"
              ]
            },
            "description": "Obtiene todas las clases disponibles del gimnasio"
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "http://localhost:8080/clases",
                  "protocol": "http",
                  "host": [
                    "localhost"
                  ],
                  "port": "8080",
                  "path": [
                    "clases"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "[\n  {\n    \"id\": 1,\n    \"name\": \"Yoga\",\n    \"description\": \"Clase de yoga relajante\",\n    \"level\": \"BEGINNER\",\n    \"durationMinutes\": 60,\n    \"defaultCapacity\": 20\n  },\n  {\n    \"id\": 2,\n    \"name\": \"Crossfit\",\n    \"description\": \"Entrenamiento de alta intensidad\",\n    \"level\": \"ADVANCED\",\n    \"durationMinutes\": 45,\n    \"defaultCapacity\": 15\n  }\n]"
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ]
}

